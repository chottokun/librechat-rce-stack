# ==============================================================================
# LibreChat RCE Stack - 環境変数設定テンプレート
# ==============================================================================
# 【利用方法】
# 手動でシークレットを生成する必要はありません。
# ./setup.sh を実行すると、本ファイルをベースに安全な暗号論的乱数・Ed25519鍵ペアが
# 自動生成されて .env に書き込まれます。
#
#   $ ./setup.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ネットワーク & ドメイン設定
# ------------------------------------------------------------------------------
# 外部公開ドメイン名（Nginx server_name および証明書 SAN と連動）
DOMAIN=localhost

# Nginx 公開ポート
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 2. LibreChat コア設定
# ------------------------------------------------------------------------------
LIBRECHAT_PORT=3080
DOMAIN_CLIENT=https://localhost
DOMAIN_SERVER=https://localhost
CONFIG_BYPASS_VALIDATION=true

# ユーザー登録ポリシー
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_PASSWORD_RESET=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false

# セッション有効期限（ミリ秒）
SESSION_EXPIRY=86400000          # 24時間
REFRESH_TOKEN_EXPIRY=2592000000  # 30日

# ------------------------------------------------------------------------------
# 3. 自動生成シークレット（※ ./setup.sh が初回起動時に自動生成します）
# ------------------------------------------------------------------------------
# LibreChat 署名・認証鍵
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# データベース & キャッシュ認証
REDIS_PASSWORD=
MINIO_ROOT_USER=enterprise_rce_admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=code-interpreter-files

# Code Interpreter 内部サービス連携トークン & Egress グラント
CODEAPI_INTERNAL_SERVICE_TOKEN=
CODEAPI_EGRESS_GRANT_SECRET=

# サンドボックス実行マニフェスト鍵ペア (Ed25519, Base64 PKCS#8/SPKI DER)
CODEAPI_EXECUTION_MANIFEST_PRIVATE_KEY=
SANDBOX_EXECUTION_MANIFEST_PUBLIC_KEY=

# LibreChat ↔ Code Interpreter API 認証用 Ed25519 JWK / JWKS
# LibreChat (API) が所持する署名用秘密鍵 (JWK JSON)
CODEAPI_JWT_PRIVATE_JWK_JSON=
# Code Interpreter (code-api) が所持する検証用公開鍵セット (JWKS JSON)
CODEAPI_JWT_JWKS_JSON=
CODEAPI_JWT_KID=
CODEAPI_JWT_ALGORITHM=EdDSA
CODEAPI_JWT_ISSUER=librechat
CODEAPI_JWT_AUDIENCE=codeapi
CODEAPI_JWT_SINGLE_TENANT_ID=default

# ------------------------------------------------------------------------------
# 4. サンドボックス実行モード
# ------------------------------------------------------------------------------
# ./setup.sh が /dev/kvm の有無を自動判定して設定します。
#   true : MicroVM (libkrun) による最高水準のハードウェア仮想化隔離
#   false: NsJail Direct モード (クラウドVMやKVM非対応環境用)
KVM_ENABLED=true
KVM_DEVICE_PATH=/dev/kvm

# サンドボックスリソース制限
SANDBOX_OUTPUT_MAX_SIZE=65536
SANDBOX_RUN_TIMEOUT=300000
SANDBOX_RUN_CPU_TIME=300000
PYTHON_CONCURRENCY=5
OTHER_CONCURRENCY=15

# ------------------------------------------------------------------------------
# 5. 外部 / 社内 LLM API 設定（必要に応じて設定）
# ------------------------------------------------------------------------------
# さくらインターネット AI 高火力 API / OpenAI互換プロキシ
EXTERNAL_API_URL=
EXTERNAL_API_KEY=
EXTERNAL_LLM_MODEL=

# Google Gemini API
GEMINI_API_KEY=

# OpenAI 公式 API
# OPENAI_API_KEY=
